<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>hds</AssemblyName>
    <RootNamespace>hds</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Runtime data lives in the repository (../data, ../config) and is copied next to the binary -->
    <HdsRepoRoot>$(MSBuildProjectDirectory)\..</HdsRepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="hds.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
    <!-- EF Core 5 does not work on .NET 6+ (QueryableMethods initialization fails), keep EF and Pomelo on 8.x -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
    <PackageReference Include="MySql.Data" Version="8.4.0" />
    <PackageReference Include="NetCoreServer" Version="3.0.20" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.2" />
  </ItemGroup>

  <!-- Game data is not copied: ServerPaths finds the repository data folder at runtime.
       Only the (small) config templates are copied next to the binary. -->
  <ItemGroup>
    <None Include="$(HdsRepoRoot)\config\*.xml">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
